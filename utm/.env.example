# App
APP_PORT=8080
GRPC_PORT=9090
APP_ENV=development

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=utm_user
POSTGRES_PASSWORD=utm_pass
POSTGRES_DB=utm_db
POSTGRES_SSL_MODE=disable

# MongoDB
MONGO_URI=mongodb://utm_user:utm_pass@localhost:27017/utm_db?authSource=admin
MONGO_DB=utm_db

# JWT
JWT_SECRET=change-this-to-a-secure-random-secret-min-32-chars
JWT_EXPIRY_HOURS=24
JWT_REFRESH_DAYS=7

# RabbitMQ
RABBITMQ_URI=amqp://utm_user:utm_pass@localhost:5672/

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
